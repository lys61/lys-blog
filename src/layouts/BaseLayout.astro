---
const { title = 'LYS Blog', description = 'A personal blog about code, notes, and ideas.' } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="stylesheet" href="/styles/global.css" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">LYS Blog</a>
      <nav aria-label="Primary navigation">
        <a href="/">首页</a>
        <a href="/blog">文章</a>
        <a href="/about">关于</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <span>© 2026 LYS Blog</span>
    </footer>
  </body>
</html>
